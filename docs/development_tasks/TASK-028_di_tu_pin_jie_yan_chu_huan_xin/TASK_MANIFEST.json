  "steps": [
    {
      "step_id": "step-01",
      "title": "黑边合拢、左上角起逐张拼合与接缝金线",
      "behavior": "0.0~1.6 秒黑边合拢到 92px、镜头从玩家特写缓拉到全图；0.5~2.5 秒九块图按 pin_jie_shun_xu=[0,1,2,3,4,5,6,7,8]（左上→右上→第二行→右下）每块约 0.15 秒错峰显影：初始就在最终中心，alpha 0→1、scale 0.96→1、并从上方 18~24px 落下拼合，各带一圈波纹；玩家格不再固定最后，按所在格序号出现；1.2~2.2 秒接缝金线随已拼好的边分段亮到 0.55；不再大距离飞入、不回弹。",
      "main_concept": "行优先顺序拼合：用固定 0..8 序列表达「一张一张拼下来」，而不是先四角再中心",
      "files": [
        "scripts/di_tu_pin_jie_yan_chu.gd",
        "tests/ce_panding.gd"
      ],
      "automated_checks": [
        "pin_jie_shun_xu 等于 [0,1,2,3,4,5,6,7,8]",
        "九块图初始位置等于 ge_zi_zhong_xin(pian)，逐块 alpha/scale/落下显影",
        "运行时不再调用 fei_ru_qi_dian() 计算起点",
        "WAN_JIA_JU_JIAO=0.88 契约不变"
      ],
      "manual_checks": [
        "F5 目检左上角到右下角逐张拼合与波纹"
      ]
    },
    {
      "step_id": "step-02",
      "title": "玩家格焦点、区域名打字机与镜头呼吸",
      "behavior": "2.5~3.6 秒玩家格金框亮起、镜头轻推近玩家 0.6 秒并停留；区域名与水位小字用 visible_ratio 打字机显现；3.6~4.5 秒镜头缓回全图、区域名淡出；去掉震惊气泡与「浮游望青天」大字。",
      "main_concept": "单一焦点：同一时间只让一个元素成为视觉中心",
      "files": [
        "scripts/di_tu_pin_jie_yan_chu.gd"
      ],
      "automated_checks": [
        "不再创建震惊气泡节点",
        "区域名 visible_ratio 从 0 到 1",
        "玩家位置/旋转在演出结束后还原"
      ],
      "manual_checks": [
        "F5 目检玩家格金框与打字机节奏"
      ]
    },
    {
      "step_id": "step-03",
      "title": "机械船动态入场、冷蓝背光与去红闪震屏",
      "behavior": "4.5~5.9 秒播放 jing_bao 与决战 BGM，船体用 4 帧 AnimatedSprite2D 从画面上缘 1.4 秒压入，冷蓝背光最高 alpha 约 0.12，全图压暗 12%，标题打字机 0.05 秒/字；5.9~6.6 秒船停驻、舱灯闪 2 次、落点一次气泡；无红闪、无震屏、无玩家翘头。",
      "main_concept": "动态剪影：用 4 帧船体与冷色背光制造压迫，而不是靠红闪与震屏堆叠",
      "files": [
        "scripts/di_tu_pin_jie_yan_chu.gd"
