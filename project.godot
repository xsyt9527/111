; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="深海食纪"
config/description="肉鸽类大鱼吃小鱼：吃掉比你小的鱼，升级选强化，长成深海霸主。"
run/main_scene="res://scenes/ZhuJieMian.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

ZhangBen="*res://scripts/zhang_ben.gd"
CunDang="*res://scripts/cun_dang.gd"
YinXiang="*res://scripts/yin_xiang.gd"
HuaZhi="*res://scripts/hua_zhi.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation="landscape"

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-Regular.otf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="yu"
2d_physics/layer_2="yu_npc"
2d_physics/layer_3="rou_kuai"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
